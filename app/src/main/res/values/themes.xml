<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HUCallBlocker" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/screen_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.HUCallBlocker.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.HUCallBlocker.OutlineButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/card_stroke</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">46dp</item>
    </style>
</resources>
